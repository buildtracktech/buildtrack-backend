# SQLAlchemy URL. The default is a SQLite database in the repository root.
BUILDTRACK_DATABASE_URL=sqlite:///./buildtrack.db

# Directory used by scan and project-document uploads.
BUILDTRACK_UPLOAD_DIR=./uploads

# Maximum allowed PDF size in bytes (25 MiB by default).
BUILDTRACK_MAX_PDF_SIZE_BYTES=26214400

# Replace before any shared or production deployment.
BUILDTRACK_JWT_SECRET=replace-with-a-long-random-secret

# JWT lifetime in minutes.
BUILDTRACK_ACCESS_TOKEN_EXPIRE_MINUTES=480
